{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Ninja Multi-Config)",
            "description": "Standalone kwxFFI test project using Ninja Multi-Config",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/../build/tests"
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "default",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "cheap",
            "displayName": "Cheap checks",
            "configurePreset": "default",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "label": "cheap"
                }
            }
        }
    ]
}
